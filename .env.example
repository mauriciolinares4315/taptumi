# Copia este archivo a .env y completa tus valores reales.
# NUNCA subas el .env real a git ni lo compartas en ningun chat.

# ─── Flask ───
SECRET_KEY=
FLASK_ENV=development

# ─── Turso (opcional; si se deja vacio, se usa SQLite local) ───
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Cloudinary (opcional; si se deja vacio, las fotos se guardan en static/uploads) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Seguridad ───
MASTER_PASSWORD=

# ─── CORS ───
# Dominios que pueden llamar a /api/* desde JS de otro origen.
# Deja vacio si tu frontend siempre se sirve desde el mismo dominio que la API.
# Ejemplo: CORS_ORIGINS=https://tudominio.com,https://otrodominio.com
CORS_ORIGINS=
